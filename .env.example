# Google Gemini
# 실제 값은 .env에만 작성하고, 이 파일에는 예시/기본 방향만 남긴다.
GEMINI_API_KEY=
MAIN_MODEL=gemini-3-flash-preview
FALLBACK_MODEL=gemini-3.1-flash-lite

# Gemini thinking levels
# 허용값: minimal, low, medium, high
DEFINITION_REWRITE_THINKING_LEVEL=medium
DUPLICATE_ALIAS_JUDGMENT_THINKING_LEVEL=medium
CATEGORY_ASSIGNMENT_THINKING_LEVEL=minimal
SOURCE_CONFLICT_RESOLUTION_THINKING_LEVEL=high

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=jangdokdae-dictionary